# Suburi environment variables. Names only, never values.
# Copy to .env.local (gitignored). Validated by lib/config.ts; dev:session also loads it.

# Neon pooled connection string, used at runtime.
DATABASE_URL=
# Neon direct (unpooled) connection string, used by drizzle-kit migrate.
DATABASE_URL_UNPOOLED=

# Better Auth signing secret (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Base URL of this deployment, e.g. http://localhost:3000.
BETTER_AUTH_URL=

# Google OAuth client, the only identity provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The one email address allowed to sign in.
ALLOWED_EMAIL=

# Every model call. The model strings are constants in lib/ai/models.ts, never variables here.
OPENAI_API_KEY=

# Presigning the audio PUT and GET. One IAM user per environment, with only s3:PutObject and
# s3:GetObject on its own prefix (docs/12-deployment.md §3 step 5).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket's region, e.g. ap-northeast-1.
AWS_REGION=
# The one bucket.
S3_BUCKET=
# prod/ in production, dev/ everywhere else. The only thing separating develop's audio from real audio.
S3_PREFIX=
