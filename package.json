{
  "name": "suburi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && next dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:e2e": "playwright test",
    "audit:ci": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit.mts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-on-deploy.mts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mts",
    "db:seed:develop": "node --env-file-if-exists=.env scripts/seed-develop.mts",
    "dev:session": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/resolve-ts.mts scripts/dev-session.mts",
    "fixtures:import": "node scripts/make-import-fixtures.mts",
    "ear-check": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/resolve-ts.mts scripts/ear-check.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/lib-storage": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@base-ui/react": "1.8.0",
    "@sentry/nextjs": "11.1.0",
    "@sentry/node": "11.1.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "0.45.3",
    "mammoth": "1.12.3",
    "next": "16.3.8",
    "openai": "7.27.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "pg-copy-streams": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
