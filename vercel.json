{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "develop": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/self-check",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 20 * * 0"
    }
  ]
}
